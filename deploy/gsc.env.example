COD5_GSC_PORTAL=replace-with-portal-key
HOME=/gsc
COD5_GSC_ENABLED=1
COD5_GSC_ORIGIN=https://example.invalid
COD5_GSC_PROPERTY=sc-domain:example.invalid
COD5_GSC_PROFILE_DIR=/gsc/profile
COD5_DATABASE_FILE=/data/editorial.sqlite
COD5_GSC_CALLBACK_URL=https://codigo5.com.br/api/integrations/gsc/events
COD5_GSC_CALLBACK_TOKEN=replace-with-a-random-shared-secret
COD5_GSC_NOTIFY_TELEGRAM_USER_ID=replace-with-an-allowed-telegram-user-id
COD5_GSC_MAX_ATTEMPTS=3
